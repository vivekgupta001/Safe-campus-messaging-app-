# SafeCampus Backend Environment Settings
PORT=5000

# Connection URI for Mongoose. If this is unavailable, server automatically falls back to backend/local_db.json
MONGODB_URI=mongodb://127.0.0.1:27017/safecampus

# Secure hash key for JWT session tokens
JWT_SECRET=safecampussupersecretjwtkey123

# Node Environment
NODE_ENV=development
